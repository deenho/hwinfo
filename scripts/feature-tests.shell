#!/bin/bash -ex
# Build and test the default configuration.
meson setup build --buildtype=release
meson compile -C build
meson test -C build --verbose

# Verify each individual component can be built in isolation.
for component in os mainboard cpu disk ram gpu battery; do
  rm -rf build
  case "$component" in
    os)        meson setup build -Dhwinfo_os=true -Dhwinfo_mainboard=false -Dhwinfo_cpu=false -Dhwinfo_disk=false -Dhwinfo_ram=false -Dhwinfo_gpu=false -Dhwinfo_gpu_opencl=false -Dhwinfo_battery=false -Dhwinfo_network=false ;;
    mainboard) meson setup build -Dhwinfo_os=false -Dhwinfo_mainboard=true -Dhwinfo_cpu=false -Dhwinfo_disk=false -Dhwinfo_ram=false -Dhwinfo_gpu=false -Dhwinfo_gpu_opencl=false -Dhwinfo_battery=false -Dhwinfo_network=false ;;
    cpu)       meson setup build -Dhwinfo_os=false -Dhwinfo_mainboard=false -Dhwinfo_cpu=true -Dhwinfo_disk=false -Dhwinfo_ram=false -Dhwinfo_gpu=false -Dhwinfo_gpu_opencl=false -Dhwinfo_battery=false -Dhwinfo_network=false ;;
    disk)      meson setup build -Dhwinfo_os=false -Dhwinfo_mainboard=false -Dhwinfo_cpu=false -Dhwinfo_disk=true -Dhwinfo_ram=false -Dhwinfo_gpu=false -Dhwinfo_gpu_opencl=false -Dhwinfo_battery=false -Dhwinfo_network=false ;;
    ram)       meson setup build -Dhwinfo_os=false -Dhwinfo_mainboard=false -Dhwinfo_cpu=false -Dhwinfo_disk=false -Dhwinfo_ram=true -Dhwinfo_gpu=false -Dhwinfo_gpu_opencl=false -Dhwinfo_battery=false -Dhwinfo_network=false ;;
    gpu)       meson setup build -Dhwinfo_os=false -Dhwinfo_mainboard=false -Dhwinfo_cpu=false -Dhwinfo_disk=false -Dhwinfo_ram=false -Dhwinfo_gpu=true -Dhwinfo_gpu_opencl=false -Dhwinfo_battery=false -Dhwinfo_network=false ;;
    battery)   meson setup build -Dhwinfo_os=false -Dhwinfo_mainboard=false -Dhwinfo_cpu=false -Dhwinfo_disk=false -Dhwinfo_ram=false -Dhwinfo_gpu=false -Dhwinfo_gpu_opencl=false -Dhwinfo_battery=true -Dhwinfo_network=false ;;
  esac
  meson compile -C build
done

rm -rf build
